\newcommand{\entregableportada}[3]{%
  \begin{titlepage}
    \thispagestyle{empty}
    \pagenumbering{gobble}
    \noindent{\color{InformeInk}\rule{\textwidth}{4pt}}\par
    \vspace{13mm}
    {\small\bfseries\color{InformeTeal} ISABEL FAUBEL \enspace / \enspace PORTFOLIO\par}
    \vspace{28mm}
    {\fontsize{31}{37}\selectfont\bfseries\color{InformeInk}#1\par}
    \vspace{7mm}
    {\Large\color{InformeBlue}#2\par}
    \vspace{12mm}
    {\color{InformeTeal}\rule{28mm}{2pt}\par}
    \vfill
    {\small\bfseries\color{InformeInk} DOCUMENTACIÓN DEL PROYECTO\par}
    \vspace{3mm}
    {\normalsize\color{InformeGray}#3\par}
    \vspace{12mm}
    {\color{InformeLine}\rule{\textwidth}{0.8pt}\par}
    \vspace{3mm}
    {\footnotesize\color{InformeGray} Preparado para revisión y seguimiento\par}
  \end{titlepage}
  \pagenumbering{arabic}
}

\newcommand{\rutaweb}[1]{\texttt{\detokenize{#1}}}
\newcommand{\archivo}[1]{\texttt{\detokenize{#1}}}
\newcommand{\prioridad}[1]{%
  \ifthenelse{\equal{#1}{P0}}{\textcolor{InformeRed}{\textbf{P0}}}{%
  \ifthenelse{\equal{#1}{P1}}{\textcolor{InformeAmber}{\textbf{P1}}}{%
  \textcolor{InformeBlue}{\textbf{P2}}}}%
}

\newcounter{accion}[chapter]
\newcommand{\tarea}[2]{%
  \noalign{\stepcounter{accion}}%
  {\footnotesize\bfseries\color{InformeGray}\thechapter.\arabic{accion}} &
  {\footnotesize\prioridad{#1}} &
  {\small\RaggedRight #2} &
  \centering\arraybackslash $\square$ \tabularnewline
  \arrayrulecolor{InformeLine}\hline
}
\newenvironment{listaacciones}{%
  \setlength{\LTleft}{0pt}%
  \setlength{\LTright}{0pt}%
  \setlength{\tabcolsep}{4pt}%
  \renewcommand{\arraystretch}{1.45}%
  \begin{longtable}{@{}m{12mm}m{11mm}m{\dimexpr\textwidth-41mm-6\tabcolsep\relax}>{\centering\arraybackslash}m{18mm}@{}}
  \rowcolor{InformeInk}
  \color{white}\footnotesize\bfseries ID &
  \color{white}\footnotesize\bfseries Prior. &
  \color{white}\footnotesize\bfseries Acción / comprobación &
  \color{white}\footnotesize\bfseries Hecho \tabularnewline
  \endfirsthead
  \rowcolor{InformeInk}
  \color{white}\footnotesize\bfseries ID &
  \color{white}\footnotesize\bfseries Prior. &
  \color{white}\footnotesize\bfseries Acción / comprobación &
  \color{white}\footnotesize\bfseries Hecho \tabularnewline
  \endhead
  \endfoot
}{%
  \end{longtable}%
}

\newcommand{\criteriocierre}[1]{%
  \medskip
  \noindent\colorbox{InformeSoft}{%
    \parbox{\dimexpr\textwidth-2\fboxsep\relax}{%
      \small\textbf{\color{InformeBlue}CRITERIO DE CIERRE} \enspace #1
    }%
  }%
  \medskip
}

\newcommand{\evidencia}[1]{%
  {\small\color{InformeGray}\textit{Evidencia: #1}}%
}

